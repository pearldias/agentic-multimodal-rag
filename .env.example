# Application Settings
PROJECT_NAME="Multimodal RAG API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Settings
HOST="127.0.0.1"
PORT=8000

# Google Gemini Embedding Settings
GOOGLE_API_KEY="your-google-api-key-here"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768

# Google Gemini LLM Settings
GEMINI_LLM_MODEL="gemini-3.6-flash"
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0

# Cohere Reranker Settings
COHERE_API_KEY="your-cohere-api-key-here"
COHERE_RERANK_MODEL="rerank-v4.0-fast"
RERANK_INITIAL_K=15
RERANK_TOP_K=5
